# Private Lounge BFF Runtime Configuration (Local Emulator / Non-Production)
PORT=8083
NODE_ENV=development
APP_VERSION=v1.45.2
DISCLAIMER_VERSION=1
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
LOUNGE_PUBLIC_ORIGIN=http://localhost:4300

# Optional local emulator auth & batch bypass switches (strictly inert when NODE_ENV=production)
NO_AUTH=false
BATCH_SECRET_KEY=local-lounge-batch-secret

# Persona & GCP / Firebase Project Identifiers (Use placeholders outside .env)
ACTIVE_PERSONA_ID=rebecca
GCP_PROJECT_ID=<GCP_PROJECT_ID>
GOOGLE_CLOUD_PROJECT=<GCP_PROJECT_ID>
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional Identity Platform tenant ID separating Lounge Auth from admin/public auth blocking
LOUNGE_FIREBASE_TENANT_ID=

# Public Firebase Web SDK configuration delivered via GET /api/v1/lounge/config
FIREBASE_WEB_API_KEY=<FIREBASE_WEB_API_KEY>
FIREBASE_WEB_AUTH_DOMAIN=<GCP_PROJECT_ID>.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=<GCP_PROJECT_ID>
FIREBASE_WEB_APP_ID=<FIREBASE_WEB_APP_ID>

# Non-PII HMAC Keyring for anti-fraud welcome/trial tracking
LOUNGE_TRIAL_HMAC_SECRET_V1=local-emulator-lounge-trial-hmac-secret-v1
# LOUNGE_TRIAL_HMAC_KEYS={"1":"...","2":"..."}

# Regional & Compliance Controls (Phase 1 disables EEA/UK/CH paid purchases)
LOUNGE_PHASE2_EEA_ENABLED=false
DEFAULT_GEO_COUNTRY=JP

# Stripe Test Credentials (NEVER supply sk_live_* / rk_live_* / pk_live_* outside production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_TRIAL_JPY=price_test_trial_jpy
STRIPE_PRICE_CHARGE_JPY=price_test_charge_jpy
STRIPE_PRICE_STANDARD_JPY=price_test_standard_jpy
STRIPE_PRICE_TRIAL_USD=price_test_trial_usd
STRIPE_PRICE_CHARGE_USD=price_test_charge_usd
STRIPE_PRICE_STANDARD_USD=price_test_standard_usd

# Gemini AI Configuration (Flash-Lite MINIMAL + Gemini 3 search_web Grounding + Embedding 2)
GEMINI_API_KEY=
LOUNGE_GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
LOUNGE_GEMINI_SEARCH_MODEL=gemini-3.1-flash-lite
LOUNGE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LOUNGE_MAX_OUTPUT_TOKENS=450
LOUNGE_GEMINI_PAID_TIER=false
LOUNGE_IMAGE_SIMILARITY_THRESHOLD=0.45
LOUNGE_GLOBAL_DAILY_SIGNUP_CAP=2000
LOUNGE_GLOBAL_DAILY_TURN_CAP=50000
