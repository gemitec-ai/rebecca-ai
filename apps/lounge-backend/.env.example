# Private Lounge BFF Runtime Configuration (Local Emulator / Development Skeleton)
PORT=8083
NODE_ENV=development
APP_VERSION=v1.45.2
DISCLAIMER_VERSION=1
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://127.0.0.1:4300

# Optional local emulator bypass switch (strictly inert when NODE_ENV=production)
NO_AUTH=false

# Persona & GCP / Firebase Project Identifiers (Use placeholders outside .env)
ACTIVE_PERSONA_ID=rebecca
GCP_PROJECT_ID=<GCP_PROJECT_ID>
GOOGLE_CLOUD_PROJECT=<GCP_PROJECT_ID>
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
